# --- Required ---
ANTHROPIC_API_KEY=sk-ant-...

# --- LLM (optional overrides) ---
BRAIN_MODEL=claude-opus-4-7
BRAIN_EFFORT=high

# --- Portfolio source: "manual" or "robinhood" ---
PORTFOLIO_SOURCE=manual

# --- Robinhood (READ-ONLY; only used when PORTFOLIO_SOURCE=robinhood) ---
# The brain NEVER places trades. These are read-only credentials.
# MFA: set RH_MFA to your authenticator TOTP secret, OR leave blank and
# you'll be prompted for the code on first login.
RH_USERNAME=
RH_PASSWORD=
RH_MFA=
