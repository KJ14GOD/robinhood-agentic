# --- Required ---
ANTHROPIC_API_KEY=sk-ant-...

# --- LLM (optional overrides) ---
BRAIN_MODEL=claude-opus-4-7
BRAIN_EFFORT=high

# --- Portfolio source: "manual" or "robinhood" ---
PORTFOLIO_SOURCE=manual

# --- Database ---
# Local fallback uses SQLite at data_store/brain.db.
# For production-ish dev use Postgres/Neon:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=sqlite:///data_store/brain.db

# --- Refresh behavior ---
PORTFOLIO_TTL_SECONDS=30
QUOTE_TTL_SECONDS=60
SIGNAL_TTL_SECONDS=900
SCREEN_TTL_SECONDS=1800
NEWS_TTL_SECONDS=900
AUTO_REFRESH_SECONDS=120
AUTO_BRIEFINGS=true
MORNING_BRIEF_TIME=06:30
EVENING_BRIEF_TIME=16:30

# --- Robinhood (READ-ONLY; only used when PORTFOLIO_SOURCE=robinhood) ---
# The brain NEVER places trades. These are read-only credentials.
# MFA: set RH_MFA to your authenticator TOTP secret, OR leave blank and
# you'll be prompted for the code on first login.
RH_USERNAME=
RH_PASSWORD=
RH_MFA=
